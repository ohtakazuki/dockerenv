{
  "name": "TensorFlow Env (Official Image)",
  "dockerComposeFile": "compose.yml",
  "service": "python",
  // workspaceFolder を /app に更新
  "workspaceFolder": "/app",
  // remoteUser を appuser (Dockerfileで作成したユーザー) に設定
  "remoteUser": "appuser",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        // (任意) TensorFlow/Keras 開発に役立つ拡張機能
        // "ms-toolsai.jupyter"
      ],
      "settings": {
        "editor.tabSize": 4,
        // TF公式イメージ内のPythonパスを確認して設定 (異なる場合がある)
        "python.defaultInterpreterPath": "/usr/bin/python3", // TFイメージによってパスが異なる可能性あり
        "python.linting.pylintEnabled": true,
        "python.linting.enabled": true
      }
    }
  },
  // TensorBoard 用のポートをフォワード
  "forwardPorts": [6006]
}
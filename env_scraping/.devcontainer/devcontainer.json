{
  "name": "Scraping Python Env",
  "dockerComposeFile": "compose.yml",
  "service": "python",
  // workspaceFolder を /app に更新
  "workspaceFolder": "/app",
  // remoteUser を appuser に設定
  "remoteUser": "appuser",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
        // (任意) HTML/Web 開発系の拡張機能も役立つ場合がある
        // "ms-vscode.live-server" 
      ],
      "settings": {
        "editor.tabSize": 4,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.pylintEnabled": true,
        "python.linting.enabled": true
      }
    }
  }
  // (任意) 必要に応じてポートフォワード設定を追加
  // "forwardPorts": [8000],
}